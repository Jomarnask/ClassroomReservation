# ──────────────────────────────────────────────────────────────
# STAGING  –  backend/.env.staging
# ──────────────────────────────────────────────────────────────
# This file is loaded automatically when APP_ENV=staging.
# Copy this template:  copy .env.staging.example .env.staging
# Then fill in real values. .env.staging is git-ignored.
#
# Staging mirrors production settings (APP_DEBUG=false, strict
# CORS) but points to its own URLs so you can test deployments
# without touching the live production environment.
# ──────────────────────────────────────────────────────────────

APP_DEBUG=false

# Staging frontend URL (e.g. a Vercel preview or staging deploy)
FRONTEND_URL=https://YOUR_STAGING_PROJECT.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR_STAGING_PROJECT.vercel.app

# Override DB / Supabase credentials here if staging uses
# a separate project. Otherwise, the base .env values are used.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require
