# ──────────────────────────────────────────────────────────────
# PRODUCTION  –  backend/.env.production
# ──────────────────────────────────────────────────────────────
# This file is loaded automatically when APP_ENV=production.
# Copy this template:  copy .env.production.example .env.production
# Then fill in real values. .env.production is git-ignored.
#
# Production is the CLEAN live environment serving real users.
# Test changes in staging (APP_ENV=staging) first before
# promoting to production.
#
# On Render the env vars are set in the dashboard, so this file
# is only needed if you run the production config locally.
# ──────────────────────────────────────────────────────────────

APP_DEBUG=false

# Production frontend URL (Vercel)
FRONTEND_URL=https://YOUR_PRODUCTION_PROJECT.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR_PRODUCTION_PROJECT.vercel.app

# Override DB / Supabase credentials here if production uses
# a separate project. Otherwise, the base .env values are used.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require
