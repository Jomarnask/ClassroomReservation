# ──────────────────────────────────────────────────────────────
# TESTING  –  backend/.env.testing
# ──────────────────────────────────────────────────────────────
# This file is loaded automatically when APP_ENV=testing.
# Copy this template:  copy .env.testing.example .env.testing
# Then fill in real values. .env.testing is git-ignored.
# ──────────────────────────────────────────────────────────────

APP_DEBUG=true

# Frontend origin(s) for the testing / staging environment
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Override DB / Supabase credentials here if your testing
# environment uses a different project or database.
# Otherwise, the base .env values are used automatically.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require
