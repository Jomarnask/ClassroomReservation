# ──────────────────────────────────────────────────────────────
# BASE ENVIRONMENT  –  backend/.env
# ──────────────────────────────────────────────────────────────
# This file holds shared / default values for ALL environments.
# Environment-specific overrides live in .env.{APP_ENV}:
#
#   .env.local        ← loaded when APP_ENV=local       (default)
#   .env.staging      ← loaded when APP_ENV=staging     (prod-like, for testing)
#   .env.production   ← loaded when APP_ENV=production  (clean live env)
#
# How it works:
#   1. bootstrap.php loads this base .env first.
#   2. If a file named .env.{APP_ENV} exists, it is loaded next
#      and any matching keys OVERRIDE the base values.
#
# Quick-start:
#   copy .env.example .env
#   copy .env.local.example .env.local            ← for local dev
#   copy .env.staging.example .env.staging        ← for staging (test prod-like)
#   copy .env.production.example .env.production  ← for production (clean live)
#
# All .env* files (except *.example) are git-ignored.
# ──────────────────────────────────────────────────────────────

# Which environment to run. Determines which .env.{value} file is loaded.
# Valid values: local | staging | production
APP_ENV=local

APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Local frontend origin(s) separated by comma
FRONTEND_URL=http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# Supabase Auth verification
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase PostgreSQL connection (Use Session Pooler for Render / serverless)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=YOUR_RESTRICTED_DATABASE_LOGIN
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require
