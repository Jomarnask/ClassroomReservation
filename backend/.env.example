APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Local frontend origin(s) separated by comma
FRONTEND_URL=http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# Supabase Auth verification
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase PostgreSQL connection (Use Session Pooler for Render / serverless)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=YOUR_RESTRICTED_DATABASE_LOGIN
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require
