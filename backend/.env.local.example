# ──────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT  –  backend/.env.local
# ──────────────────────────────────────────────────────────────
# This file is loaded automatically when APP_ENV=local (the default).
# Copy this template:  copy .env.local.example .env.local
# Then fill in real values. .env.local is git-ignored.
# ──────────────────────────────────────────────────────────────

APP_DEBUG=true

# Frontend origin(s) used by CORS and redirect logic
FRONTEND_URL=http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# Override DB / Supabase credentials here ONLY if your local
# setup differs from the shared values in the base .env file.
# Otherwise, the base .env values are used automatically.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require
