@token = token


### Get all rooms
GET http://localhost:8000/api/rooms
Authorization: Bearer {{token}}

### Get active rooms
GET http://localhost:8000/api/rooms?active_only=true
Authorization: Bearer {{token}}

### Get a specific room
GET http://localhost:8000/api/rooms/1
Authorization: Bearer {{token}}



### Update a room
PATCH http://localhost:8000/api/rooms/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "room_name": "Updated Computer Laboratory",
    "is_active": false
}


